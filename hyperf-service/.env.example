APP_NAME=hyperf-service
APP_ENV=dev
SCAN_CACHEABLE=false

# 必须与 ThinkPHP8 的 JWT.SECRET 保持完全一致
JWT_SECRET=your_shared_super_secure_jwt_secret_key_change_me_in_prod
JWT_ALGORITHM=HS256

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_AUTH=
REDIS_PORT=6379
REDIS_DB=0

# AI 模型配置（如 OpenAI / DeepSeek / 本地 Ollama）
OPENAI_API_KEY=sk-your-openai-or-deepseek-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL_NAME=gpt-3.5-turbo
